rules_version = '2';
// SoundPin – Storage-regler (versjon 2)
// Limes inn i Firebase-konsollen: Build → Storage → Rules → Publish.
service firebase.storage {
  match /b/{bucket}/o {

    // Nye opptak, bilder og ikoner: sp/<bruker-id>/...
    match /sp/{uid}/{rest=**} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('audio/.*')
            || request.resource.contentType.matches('video/webm')
            || request.resource.contentType.matches('image/.*'));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Gamle filer fra iOS-appen
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && !allPaths.matches('sp/.*');
    }
  }
}
