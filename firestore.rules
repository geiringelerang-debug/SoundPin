rules_version = '2';
// SoundPin – Firestore-regler (versjon 8)
// Limes inn i Firebase-konsollen: Build → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function realUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function verifiedEmail() {
      return realUser() && request.auth.token.email_verified == true;
    }
    function profile() {
      return get(/databases/$(database)/documents/sp_users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return exists(/databases/$(database)/documents/sp_users/$(request.auth.uid));
    }
    // Administratorer: e-postene under (bekreftet), eller rollen «admin» gitt av en administrator.
    // Samme liste står i firebase-config.js (ADMIN_EMAILS).
    function isAdmin() {
      return (verifiedEmail() && request.auth.token.email.lower() in ['geiringelerang@gmail.com', 'gil@scanliftmaskin.no'])
        || (realUser() && hasProfile() && profile().role == 'admin');
    }
    function canPublic() {
      return isAdmin() || (realUser() && hasProfile() && profile().role in ['authorized', 'official', 'verifier', 'admin']);
    }
    // «Sikkerhet og myndighetsinfo» er bare for offentlige organer (rollen «official») og admin
    function canOfficial() {
      return isAdmin() || (realUser() && hasProfile() && profile().role == 'official');
    }
    // Kategorier: høyst to av de ni faste
    function okCats(d) {
      return !('cats' in d) || d.cats == null
        || (d.cats is list && d.cats.size() <= 2
            && d.cats.hasOnly(['practical', 'visit', 'history', 'nature', 'memories', 'local', 'arts', 'fun', 'official'])
            && (!('official' in d.cats) || canOfficial()));
    }
    function isVerifier() {
      return isAdmin() || (realUser() && hasProfile() && profile().role in ['verifier', 'admin']);
    }
    // Radius: 10–500 m, over 200 m bare for autoriserte
    function okRadius(d) {
      return !('radius' in d) || d.radius == null
        || (d.radius is number && d.radius >= 10 && d.radius <= 500 && (d.radius <= 200 || canPublic()));
    }
    function okAccess(d) {
      return !('access' in d) || d.access in ['map', 'locked', 'hidden'];
    }

    // ---- Gamle data fra iOS-appen ----
    match /pins/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // ---- Rydding i arkivet (status, tittel, kategori, eier, radius …) ----
    match /sp_archive/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // ---- Eiere av arkivspor: navn som vises og koblingen til en ny konto ----
    match /sp_legacy_owners/{lu} {
      allow read: if true;
      allow write: if isAdmin();
      // Den som har e-posten admin har koblet til eieren, kan sette linkedUid til seg selv
      allow update: if verifiedEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUid'])
        && request.resource.data.linkedUid == request.auth.uid
        && lu in get(/databases/$(database)/documents/sp_owner_claims/$(request.auth.token.email.lower())).data.legacyUids;
    }
    // E-post → arkiveiere. Holdes privat: bare admin og eieren av e-posten kan lese.
    match /sp_owner_claims/{email} {
      allow read: if isAdmin() || (verifiedEmail() && request.auth.token.email.lower() == email);
      allow write: if isAdmin();
    }

    // ---- Brukerprofiler ----
    match /sp_users/{uid} {
      allow read: if signedIn();
      allow create: if realUser() && request.auth.uid == uid && request.resource.data.role == 'user';
      allow update: if (realUser() && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role)
                    || isAdmin();
      allow delete: if isAdmin();

      // Venner: de som har åpnet invitasjonslenken til uid
      match /members/{m} {
        allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == m);
        allow create: if realUser() && request.auth.uid == m
          && request.resource.data.k == get(/databases/$(database)/documents/sp_users/$(uid)).data.inviteCode;
        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == m);
      }
      // Opplåste stedslåste spor (også for anonyme brukere)
      match /unlocks/{t} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---- Lydspor ----
    match /sp_tracks/{id} {
      allow read: if resource.data.visibility == 'public'
        || (signedIn() && (resource.data.creator == request.auth.uid
                           || request.auth.uid in resource.data.allowed))
        || isVerifier();
      allow create: if realUser()
        && request.resource.data.creator == request.auth.uid
        && request.resource.data.visibility in ['private', 'friends', 'public']
        && (request.resource.data.visibility != 'public' || canPublic())
        && (!('review' in request.resource.data) || request.resource.data.review in [null, 'pending'])
        && request.resource.data.label == 'local'
        && okRadius(request.resource.data) && okAccess(request.resource.data) && okCats(request.resource.data);
      allow update: if (realUser() && resource.data.creator == request.auth.uid
                        && request.resource.data.creator == resource.data.creator
                        && request.resource.data.label == resource.data.label
                        && request.resource.data.get('review', null) == resource.data.get('review', null)
                        && request.resource.data.get('archived', false) == resource.data.get('archived', false)
                        && (request.resource.data.visibility != 'public' || canPublic())
                        && okRadius(request.resource.data) && okAccess(request.resource.data) && okCats(request.resource.data))
                    // Verifikatorer og admin: godkjenne, avvise, verifisere og trekke tilbake
                    || (isVerifier()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['label', 'visibility', 'review', 'reviewNote', 'reviewedBy', 'reviewedAt', 'loud'])
                        && request.resource.data.label in ['local', 'verified']
                        && request.resource.data.visibility in ['private', 'friends', 'public'])
                    // Admin: arkivere (skjule) og gjenopprette rett fra kartet
                    || (isAdmin()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived', 'reviewedBy', 'reviewedAt'])
                        && request.resource.data.archived is bool);
      allow delete: if (realUser() && resource.data.creator == request.auth.uid) || isAdmin();
    }

    // ---- Lyttescore ----
    match /sp_stats/{id} {
      allow read: if true;
      allow write: if signedIn()
        && request.resource.data.keys().hasOnly(['s', 'c', 'r', 'u', 't', 'boost']);
    }

    // ---- Logg per avspilling (grunnlag for å forbedre lyttescoren). Bare admin kan lese. ----
    match /sp_events/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['track', 'uid', 'reason', 'heard', 'dur', 'mode', 'site', 'speed', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.track is string
        && request.resource.data.reason in ['completed', 'closed', 'switched', 'replaced', 'left', 'stalled', 'error', 'other']
        && request.resource.data.mode in ['move', 'activity', 'sofa'];
      allow read, delete: if isAdmin();
    }

    // ---- «Ikke riktig lenger»: hvem som har meldt et spor. Hver bruker kan legge til seg selv én gang. ----
    match /sp_flags/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['by', 'at'])
        && request.resource.data.by == [request.auth.uid];
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['by', 'at'])
        && request.resource.data.by.hasAll(resource.data.by)
        && request.resource.data.by.size() == resource.data.by.size() + 1
        && request.auth.uid in request.resource.data.by
        && !(request.auth.uid in resource.data.by);
      // Admin eller eieren av sporet kan nullstille når sporet er sjekket
      allow delete: if isAdmin()
        || (signedIn() && get(/databases/$(database)/documents/sp_tracks/$(id)).data.creator == request.auth.uid);
    }

    // ---- Innstillinger admin styrer (f.eks. skjulte merker) ----
    match /sp_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Resultater for sekvenser med tidtaking ----
    match /sp_results/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['seq', 'ms', 'over', 'limit', 'at', 'uid', 'name'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.seq is string
        && request.resource.data.ms is number && request.resource.data.ms > 0
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow delete: if isAdmin();
    }

    // ---- Rapporter ----
    match /sp_reports/{id} {
      allow create: if signedIn();
      allow read, delete: if isAdmin();
    }
  }
}
